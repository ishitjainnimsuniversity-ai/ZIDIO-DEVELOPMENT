generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Workspace {
  id          String       @id @default(cuid())
  name        String
  slug        String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  users       User[]
  invitations Invitation[]
  feedback    Feedback[]
  themes      Theme[]
  vocReports  VocReport[]
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("VIEWER") // ADMIN, ANALYST, VIEWER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String   @default("VIEWER")
  status      String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  createdAt   DateTime @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Feedback {  
  id             String       @id @default(cuid())  
  text           String  
  source         String?      @default("Website") // Website, App, Support, Survey
  customerName   String?
  customerEmail  String?
  status         String       @default("NEW") // NEW, REVIEWED, RESOLVED, ARCHIVED
  sentiment      String?      // POSITIVE, NEUTRAL, NEGATIVE
  sentimentScore Float?       // -1.0 to 1.0
  featureArea    String?
  aiRationale    String?
  aiStatus       String?      @default("COMPLETED")
  embeddingJson  String?      // Serialized 1536-dim vector for SQLite
  createdAt      DateTime     @default(now())  
  updatedAt      DateTime     @default(now()) @updatedAt
  workspaceId    String  
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  analysis       AiAnalysis?
  themeLinks     FeedbackTheme[]
}

model AiAnalysis {
  id               String    @id @default(cuid())
  feedbackId       String    @unique
  feedback         Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  sentiment        String
  sentimentScore   Float
  themesJson       String?   // JSON array of strings
  featureArea      String
  rationale        String
  model            String    @default("claude-3-5-sonnet-20241022")
  processingStatus String    @default("COMPLETED")
  createdAt        DateTime  @default(now())
}

model Theme {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  count       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt
  feedbacks   FeedbackTheme[]

  @@unique([workspaceId, name])
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
}

model VocReport {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  period          String    @default("Last 30 Days")
  totalFeedback   Int
  positivePercent Float
  neutralPercent  Float
  negativePercent Float
  topThemesJson   String    // JSON stringified themes
  spikesJson      String    // JSON stringified spikes
  aiNarrative     String
  generatedAt     DateTime  @default(now())
}
